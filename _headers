# Security Headers for YM Event Vendors
/*
  # Prevent clickjacking attacks
  X-Frame-Options: DENY

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Enable XSS protection
  X-XSS-Protection: 1; mode=block

  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin

  # Enhanced HSTS with preload
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://kit.fontawesome.com https://cdn.jsdelivr.net; connect-src 'self' https://ka-f.fontawesome.com https://kit.fontawesome.com; style-src 'self' 'unsafe-inline' https://ka-f.fontawesome.com; img-src 'self' data: https:; font-src 'self' https:; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'

  # Permissions Policy (formerly Feature Policy)
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Cache headers for static assets
/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/backdrops/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable